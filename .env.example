# FinSocratic 环境变量示例（复制为 .env 并填入真实值）
# 数据与运行环境默认放在 D 盘，避免占用 C 盘空间：
#   FINSOCRATIC_HOME=D:\FinSocratic-ResearchAgent
#   FINSOCRATIC_ENV=%FINSOCRATIC_HOME%\runtime

# DeepSeek（OpenAI 兼容）—— 用于 AI 深度研判与红队质疑（可选，缺省则优雅降级为纯确定性计算）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
